<?xml version="1.0"?>
<flowgorithm fileversion="4.2">
    <attributes>
        <attribute name="name" value="Untitled Program"/>
        <attribute name="authors" value=""/>
        <attribute name="about" value="Created with Flowonline2 - PiBOH under AGPL-3.0"/>
    </attributes>
    <function name="Main" type="None" variable="">
        <parameters/>
        <body>
            <declare name="sayac,top,ort,x" type="Real" array="False" size=""/>
            <assign variable="sayac" expression="0"/>
            <assign variable="top" expression="0"/>
            <do expression="sayac &lt; 5">
                <input variable="x"/>
                <assign variable="sayac" expression="sayac + 1"/>
                <assign variable="top" expression="top + x"/>
            </do>
            <output expression="top" newline="True"/>
            <assign variable="ort" expression="top / sayac"/>
            <output expression="ort" newline="True"/>
        </body>
    </function>
</flowgorithm>
