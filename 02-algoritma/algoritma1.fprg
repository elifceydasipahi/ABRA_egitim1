<?xml version="1.0"?>
<flowgorithm fileversion="4.2">
    <attributes>
        <attribute name="name" value="Untitled Program"/>
        <attribute name="authors" value=""/>
        <attribute name="about" value="Created with Flowonline2 - PiBOH under AGPL-3.0"/>
    </attributes>
    <function name="Main" type="None" variable="">
        <parameters/>
        <body>
            <declare name="sinav1,sinav2,ort" type="Real" array="False" size=""/>
            <input variable="sinav1"/>
            <input variable="sinav2"/>
            <assign variable="ort" expression="(sinav1+sinav2)/2"/>
            <if expression="ort &gt; 70">
                <then>
                    <output expression="&quot;iyi&quot;" newline="True"/>
                    <output expression="&quot;Ortalam:&quot; &amp; ort" newline="True"/>
                </then>
                <else>
                    <output expression="&quot;kötü&quot;" newline="True"/>
                </else>
            </if>
        </body>
    </function>
</flowgorithm>
