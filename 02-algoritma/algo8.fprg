<?xml version="1.0"?>
<flowgorithm fileversion="4.2">
    <attributes>
        <attribute name="name" value="Untitled Program"/>
        <attribute name="authors" value=""/>
        <attribute name="about" value="Created with Flowonline2 - PiBOH under AGPL-3.0"/>
    </attributes>
    <function name="Main" type="None" variable="">
        <parameters/>
        <body>
            <declare name="i,fiyat,top,kom" type="Real" array="False" size=""/>
            <assign variable="i" expression="0"/>
            <assign variable="kom" expression="0"/>
            <do expression="i&lt;5">
                <input variable="fiyat"/>
                <if expression="fiyat &lt;50">
                    <then>
                        <assign variable="fiyat" expression="fiyat*0.03"/>
                    </then>
                    <else>
                        <assign variable="fiyat" expression="fiyat*0.02"/>
                    </else>
                </if>
                <assign variable="kom" expression="kom+fiyat"/>
                <assign variable="i" expression="i+1"/>
            </do>
            <output expression="kom" newline="True"/>
        </body>
    </function>
</flowgorithm>
